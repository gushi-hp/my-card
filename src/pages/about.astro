---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="page section">
    <div class="container">
      <div class="page-title reveal">
        <h2 class="gradient-text">关于我</h2>
        <p>准研究生 · AI 探索者</p>
      </div>

      <div class="about-simple reveal" style="max-width: 700px; margin: 0 auto; text-align: center;">
        <div class="about-avatar-wrap" style="margin: 0 auto 32px;">
          <div class="about-avatar-glow"></div>
          <div class="about-avatar-placeholder" style="width: 220px; height: 220px; border-radius: 50%; background: rgba(255,255,255,0.03); border: 2px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 64px;">
            🐣
          </div>
        </div>

        <h3 style="margin-bottom: 16px;">你好！我是 <span class="gradient-text">瞌睡药</span></h3>
        <p style="color: var(--text-dim); line-height: 1.8; font-size: 1rem;">
          喜欢独自研究 AI 的准研究生，通过不断地学习提升自己。
          用 AI 创业，致力于开发有意义的工具，让技术真正服务于生活。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
