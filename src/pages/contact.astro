---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactScene from '../components/ContactScene.astro';
---

<BaseLayout>
  <section class="page section">
    <div class="container">
      <div class="page-title reveal">
        <h2 class="gradient-text">联系我</h2>
        <p>有问题或合作意向？欢迎联系</p>
      </div>

      <div class="contact-grid">
        <!-- Form -->
        <div class="contact-form glass reveal" style="padding: 40px;">
          <form id="contact-form" onsubmit="event.preventDefault(); handleSubmit()">
            <div class="field">
              <label>你的名字</label>
              <input type="text" id="name" placeholder="输入你的名字" required />
            </div>
            <div class="field">
              <label>邮箱地址</label>
              <input type="email" id="email" placeholder="your@email.com" required />
            </div>
            <div class="field">
              <label>消息内容</label>
              <textarea id="message" placeholder="写点什么..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
              发送消息
            </button>
          </form>
        </div>

        <!-- 3D Scene -->
        <div class="reveal">
          <ContactScene />
          <div class="contact-links">
            <a href="https://github.com/你的用户名" target="_blank" class="contact-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12 24 5.37 18.63 0 12 0z"/></svg>
              GitHub
            </a>
            <a href="mailto:yourname@example.com" class="contact-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
              Email
            </a>
            <a href="#" class="contact-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>
              Twitter / X
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  window.handleSubmit = function() {
    const name = document.getElementById('name').value;
    if (!name) return;
    window.showToast && window.showToast('消息已发送，感谢联系！(演示效果)');
    document.getElementById('contact-form').reset();
  };
</script>
