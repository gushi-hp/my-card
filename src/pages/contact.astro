---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactScene from '../components/ContactScene.astro';
---

<BaseLayout>
  <section class="page section">
    <div class="container">
      <div class="page-title reveal">
        <h2 class="gradient-text">联系我</h2>
        <p>有合作意向或想聊 AI？欢迎联系</p>
      </div>

      <div class="contact-grid">
        <div class="contact-form glass reveal" style="padding: 40px;">
          <form id="contact-form" onsubmit="event.preventDefault(); handleSubmit()">
            <div class="field">
              <label>你的名字</label>
              <input type="text" id="name" placeholder="输入你的名字" required />
            </div>
            <div class="field">
              <label>邮箱地址</label>
              <input type="email" id="email" placeholder="your@email.com" required />
            </div>
            <div class="field">
              <label>消息内容</label>
              <textarea id="message" placeholder="写点什么..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
              发送消息
            </button>
          </form>
        </div>

        <div class="reveal contact-info-side">
          <div class="glass" style="padding: 32px; margin-bottom: 24px;">
            <h3 style="margin-bottom: 20px; font-size: 1.1rem;">联系方式</h3>
            <div style="display: flex; flex-direction: column; gap: 16px;">
              <a href="mailto:2024522177@qq.com" style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-card); border-radius: 10px; transition: border-color 0.3s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-dim);">邮箱</div>
                  <div style="font-size: 0.95rem;">2024522177@qq.com</div>
                </div>
              </a>
            </div>
          </div>
          <ContactScene />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  window.handleSubmit = function() {
    const name = document.getElementById('name').value;
    if (!name) return;
    window.showToast && window.showToast('消息已发送，感谢联系！(演示效果)');
    document.getElementById('contact-form').reset();
  };
</script>

<style>
  .contact-info-side a:hover {
    border-color: var(--accent) !important;
    box-shadow: 0 0 20px var(--accent-dim);
  }
  .contact-scene-wrap {
    height: 280px !important;
  }
</style>
